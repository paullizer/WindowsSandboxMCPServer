# Copy to .env and fill in. The real environment always wins, so an exported variable still
# overrides anything set here. .env is gitignored; .env.example is committed.
#
# This file is for SERVER configuration. Storyboard content - subscription ids, app names, the
# values interpolated into {{value.path}} placeholders - belongs in storyboards/values.json
# instead. Anything in values.json can end up spoken on camera or typed into the guest.

# --- Narration (Azure Speech) -------------------------------------------------
# Entra ID is the default and preferred path: no key on disk, nothing to leak into a mapped
# folder. It needs two things that are easy to miss:
#   1. the Speech resource must have a CUSTOM SUBDOMAIN (a plain regional endpoint is key-only)
#   2. the caller needs the "Cognitive Services Speech User" role on the resource
#      - subscription Owner is NOT enough, because Owner grants no data-plane actions
AZURE_SPEECH_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<speech-account>
AZURE_SPEECH_REGION=westus

# Optional. A custom or private endpoint, used instead of the region when set.
# AZURE_SPEECH_ENDPOINT=

# Fallback only. Leave empty to keep using Entra; setting this puts a secret on disk.
# AZURE_SPEECH_KEY=

# Standard neural on purpose. HD voices (anything with a `:basemodel` suffix) drop <prosody> and
# mstts:audioduration, and audioduration is how a cue gets refitted to an edited slot.
# AZURE_SPEECH_VOICE=en-US-ChristopherNeural
# AZURE_SPEECH_STYLE=
# AZURE_SPEECH_RATE=
# AZURE_SPEECH_FORMAT=riff-24khz-16bit-mono-pcm
# AZURE_SPEECH_CACHE_DIR=

# --- Sandbox ------------------------------------------------------------------
# SANDBOX_MCP_WORK_DIR=
# SANDBOX_MCP_PAYLOAD_DIR=
# SANDBOX_MCP_STORYBOARD_DIR=
# SANDBOX_MCP_MEMORY_MB=8192
# SANDBOX_MCP_NETWORKING=1
# SANDBOX_MCP_VGPU=1
# SANDBOX_MCP_WINDOW_SIZE=1600x900
# SANDBOX_MCP_BOOT_TIMEOUT_SECONDS=120
# SANDBOX_MCP_MAX_WAIT_SECONDS=600

# Optional Snagit MCP server checkout, used only by tests/smoke_recording.py.
# SNAGIT_MCP_SRC=../LocalSnagitMCPServer/src
