{
  "servers": {
    "sandbox": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "sandbox_mcp"],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "SANDBOX_MCP_WORK_DIR": "${workspaceFolder}/sessions",
        "SANDBOX_MCP_PAYLOAD_DIR": "${workspaceFolder}/payload",
        "SANDBOX_MCP_STORYBOARD_DIR": "${workspaceFolder}/storyboards"
      }
    }
  }
}
